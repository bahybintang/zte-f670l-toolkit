      "sections": [
        {
          "id": "request",
          "title": "Traceroute",
          "table": "",
          "mode": "single",
          "source": "runtime:traceroute_request",
          "row": 0,
          "fields": [
            {
              "dm": "Host",
              "label": "IP address or host name",
              "type": "string",
              "required": true,
              "min": 1,
              "max": 255,
              "pattern": "^[A-Za-z0-9.:_-]{1,255}$",
