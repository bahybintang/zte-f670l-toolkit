#!/bin/sh
# wifi_config_save <iface> <Key> <Value...>: what the MediaTek mesh daemons run to
# apply a setting the EasyMesh controller sent (SSID, AuthMode, EncrypType, WPAPSK,
# HideSSID, ...). This firmware has no such helper; apply it live with iwpriv.
# Values are never logged (WPAPSK is the network password).
[ $# -ge 3 ] || exit 1
ifc="$1"; key="$2"; shift 2
case "$ifc" in wlan[0-7]|apcli[01]) ;; *) exit 1 ;; esac
case "$key" in *[!A-Za-z0-9_]*) exit 1 ;; esac
exec iwpriv "$ifc" set "$key=$*" >/dev/null 2>&1
